# Mr. Black — Environment Variables
# Copy this to backend/.env and fill in your values.
# NEVER commit backend/.env to git.

# ── Core ──────────────────────────────────────────────────────────────────────
BLACK_API_KEY=your-secret-api-key-here
MEMORY_ENCRYPTION_KEY=

# ── Inference providers ────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# ── Market data ────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_LIVE=false

# ── Postgres (required for Docker; optional for local dev) ─────────────────────
DATABASE_URL=postgresql://black:yourpassword@localhost:5432/black
POSTGRES_DB=black
POSTGRES_USER=black
POSTGRES_PASSWORD=yourpassword

# ── Email (IMAP) ────────────────────────────────────────────────────────────────
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# ── Job apply ──────────────────────────────────────────────────────────────────
# APPLICATIONS_PATH=
# JOB_APPLY_CONFIG_PATH=
# JOB_RESUMES_DIR=
