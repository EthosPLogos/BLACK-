# BLACK Backend — copy to .env and fill in values

# ── Inference ──────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_RETRIES=2

# ── Memory ─────────────────────────────────────────────────
# MEMORY_PATH=black_memory.json       # default: backend/black_memory.json
MAX_CONVERSATIONS=500
MAX_FACTS=50
CONVERSATION_WINDOW=10
FACT_WINDOW=10

# ── Security ───────────────────────────────────────────────
# Set to a strong random string to enable API key auth.
# Leave empty to disable (local dev only — not safe for any network exposure).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
BLACK_API_KEY=

# ── Cloud Inference Fallback ────────────────────────────────
# When Ollama is unreachable, BLACK falls back to Claude API automatically.
# Leave ANTHROPIC_API_KEY empty to disable fallback (Ollama failures surface as errors).
ANTHROPIC_API_KEY=
# Model used for fallback inference (haiku = fastest + lowest cost)
FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Finance Domain ──────────────────────────────────────────
# Alpha Vantage free tier: 25 req/day, 5/min — https://www.alphavantage.co/support/#api-key
# When set, Finance Agent gets live price quotes and news headlines injected at inference time.
# Leave empty to use LLM training knowledge only.
ALPHA_VANTAGE_API_KEY=

# ── Memory Encryption ───────────────────────────────────────
# Fernet symmetric key for encrypting black_memory.json at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Existing plaintext memory is auto-encrypted on the next write after setting this key.
# WARNING: losing this key means losing access to your memory — back it up securely.
MEMORY_ENCRYPTION_KEY=

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
